{
  "description": "Repository-local enforcement for the unified engineering workflow.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_use_isms_p.py\"",
            "timeout": 10,
            "statusMessage": "Requiring ISMS-P review after file changes"
          }
        ]
      }
    ]
  }
}
